{
  "name": "gabrielcmerlin.github.io",
  "version": "1.0.0",
  "description": "Gabriel da Costa Merlin's academic website, built with Jekyll on top of the Academic Pages theme",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabrielcmerlin/gabrielcmerlin.github.io"
  },
  "keywords": [
    "jekyll",
    "academic",
    "portfolio"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gabrielcmerlin/gabrielcmerlin.github.io/issues"
  },
  "homepage": "https://gabrielcmerlin.github.io",
  "engines": {
    "node": ">= 0.10.0"
  },
  "dependencies": {
    "jquery": "^3.7.1",
    "plotly.js-dist-min": "^3.6.0"
  },
  "devDependencies": {
    "jslint": "^0.12.1",
    "onchange": "^7.1.0",
    "uglify-js": "^3.19.3"
  },
  "scripts": {
    "uglify": "uglifyjs assets/js/plugins/jquery.greedy-navigation.js assets/js/_main.js assets/js/theme.js -c -m -o assets/js/main.min.js",
    "watch:js": "onchange \"assets/js/**/*.js\" -e \"assets/js/main.min.js\" -- npm run build:js",
    "build:js": "npm run uglify"
  }
}
